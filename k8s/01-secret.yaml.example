@"
# This is a template. Copy it to 01-secret.yaml and fill in real values.
# The real 01-secret.yaml is excluded from git via .gitignore.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: url-shortener
type: Opaque
stringData:
  POSTGRES_USER: shortener
  POSTGRES_PASSWORD: CHANGE_ME
  POSTGRES_DB: shortener
"@ | Set-Content -Path k8s\01-secret.yaml.example -Encoding utf8